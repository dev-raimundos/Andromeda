# ==============================================================================
# Configuração de Variáveis de Ambiente - Coeur API
# ==============================================================================

# Perfil ativo da aplicação (dev habilita o Swagger em /swagger-ui.html; use staging/production nos demais ambientes)
SPRING_PROFILES_ACTIVE=dev

# Portas expostas no Docker
APP_PORT=8080
REDIS_PORT=6379

# Conexão com o Banco de Dados PostgreSQL Externo (obrigatório no Docker Compose)
# O banco roda em um servidor externo (100.64.10.1), acessível via VPN.
# Se o servidor exigir SSL, acrescente ?sslmode=require
DATABASE_URL=jdbc:postgresql://100.64.10.1:5432/andromeda
DATABASE_USERNAME=myuser
DATABASE_PASSWORD=secret

# Ativação/Desativação de Migrações Flyway
FLYWAY_ENABLED=true

# Conexão com o Servidor Redis
REDIS_HOST=localhost
REDIS_PASSWORD=
